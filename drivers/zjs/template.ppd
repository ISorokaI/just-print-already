*FormatVersion: "4.3"
*FileVersion: "1.1"
*LanguageVersion: English
*LanguageEncoding: ISOLatin1
*PCFileName: "JPAZJS.PPD"
*Manufacturer: "{{MFG}}"
*Product: "({{NAME}})"
*ModelName: "{{NAME}}"
*ShortNickName: "{{SHORT}}"
*NickName: "{{NAME}}, Just Print Already (arm64)"
*PSVersion: "(3010.000) 0"
*LanguageLevel: "3"
*ColorDevice: False
*DefaultColorSpace: Gray
*FileSystem: False
*Throughput: "18"
*LandscapeOrientation: Plus90
*TTRasterizer: Type42
*1284DeviceID: "MFG:{{MFG}};MDL:{{NAME}};CMD:ZJS,PJL,ACL;"
*cupsVersion: 2.2
*% The filter reads the Model here (ppd->model_number) and the defaults below via $PPD.
*cupsModelNumber: {{MODEL}}
*cupsManualCopies: False
*cupsFilter2: "application/vnd.cups-raster application/vnd.hp-zjs 0 {{FILTER}}"
*cupsFilter: "application/vnd.cups-raster 0 {{FILTER}}"

